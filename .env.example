# Jobsite Jackpot — Portfolio Demo configuration (all optional)
# Copy to ".env" only if you want to override defaults. The demo runs fine with none of these.

# Port for the local server (default 5000)
PORT=5000

# Admin password for the admin panel at /payout-board
# Demo default when unset (and not on a hosting platform): jackpot-dev
ADMIN_PASSWORD=jackpot-dev

# Flask session secret (any random string)
SECRET_KEY=change-me-for-local-demo

# NOTE: This demo sends NO real email and uses NO third-party API keys.
# There are deliberately no SendGrid / payment-provider / cloud credentials here.
